# Copy this file to .env and fill in your values.

# Required: your OpenAI-compatible API key (e.g. OpenAI or OpenRouter).
OPENAI_API_KEY=sk-...

# Optional: base URL for any OpenAI-compatible API.
# - Leave blank for OpenAI.
# - OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# Required: the model used for translation.
# - OpenAI: gpt-5-mini
# - OpenRouter slug: openai/gpt-5-mini, anthropic/claude-sonnet-4.5, qwen/qwen3-32b
OPENAI_MODEL=gpt-5-mini

# --- Local model (offline) ---
# To translate against a llama.cpp server you start yourself, run it first
# (e.g. `python -m llama_cpp.server --model models/Hy-MT2-1.8B-1.25Bit.gguf`)
# then point the tool at it. No real key is needed for a local server.
# Simplest:  python translate.py "<url>" --local
# Or via env:
# OPENAI_API_KEY=sk-local
# OPENAI_BASE_URL=http://localhost:8080/v1
# OPENAI_MODEL=Hy-MT2-1.8B

